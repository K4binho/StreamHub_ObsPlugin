{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/../build_noise_suppressor",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/../build_noise_suppressor/install",
        "OBS_CMAKE_DIR": "${sourceDir}/../.deps/cmake",
        "OBS_DEPS_DIR": "${sourceDir}/../.deps/obs-deps-2026-07-15-x64",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
