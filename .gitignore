# Build outputs and generated CMake state, regardless of component directory.
**/build/
**/build_*/
**/out/
**/.deps/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/CTestTestfile.cmake
**/*.vcxproj
**/*.vcxproj.filters
**/*.sln

# Installed JavaScript dependencies and local configuration.
**/node_modules/
**/.env
**/.env.*
!**/.env.example
**/npm-debug.log*

# Local editor and operating-system state.
**/.vs/
**/.vscode/
**/CMakeUserPresets.json
**/Thumbs.db
**/.DS_Store
