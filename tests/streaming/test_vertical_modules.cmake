# Keep the editor implementation out of its public API and compile each module.
file(READ "${SOURCE_DIR}/plugins/obs/src/streaming/vertical-workspace.h" workspace)
if(workspace MATCHES "inline .*StreamHubVerticalWorkspace::" OR workspace MATCHES "#include [\"<].*\\.cpp")
  message(FATAL_ERROR "Workspace API contains implementation")
endif()
file(READ "${SOURCE_DIR}/plugins/obs/CMakeLists.txt" build)
set(total 0)
foreach(module workspace preview interaction panels scenes sources)
  set(name "vertical-${module}.cpp")
  if(NOT build MATCHES "src/streaming/${name}")
    message(FATAL_ERROR "Module not compiled: ${name}")
  endif()
  file(READ "${SOURCE_DIR}/plugins/obs/src/streaming/${name}" content)
  string(REGEX MATCHALL "\n[^\n]*StreamHubVertical(Workspace|Preview)::[~A-Za-z]+\\(" definitions "${content}")
  list(LENGTH definitions count)
  math(EXPR total "${total}+${count}")
endforeach()
if(NOT total EQUAL 62)
  message(FATAL_ERROR "Expected 62 extracted editor methods, got ${total}; review module inventory if API changed")
endif()
