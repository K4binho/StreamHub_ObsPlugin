# Public HTTPS URL. Provider redirect URIs must match derived callback URLs exactly.
BROKER_PUBLIC_BASE_URL=https://oauth.example.com
PORT=10000
NODE_ENV=production

# Shared OAuth applications. Never commit real values.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional explicit callback overrides. Must stay under BROKER_PUBLIC_BASE_URL.
# KICK_REDIRECT_URI=https://oauth.example.com/v1/oauth/kick/callback
# YOUTUBE_REDIRECT_URI=https://oauth.example.com/v1/oauth/youtube/callback
